# --- Search (required) --------------------------------------------------
# Tavily powers the search executor (https://tavily.com).
TAVILY_API_KEY=tvly-...

# --- Model (optional) ---------------------------------------------------
# Either key works. Without one the agent still runs: the plan is templated and
# the brief quotes passages instead of writing them.
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides -------------------------------------------------
# auto (default) | gemini | anthropic | none
MIA_LLM_PROVIDER=auto
MIA_GEMINI_MODEL=gemini-2.5-flash
MIA_MODEL=claude-opus-5
MIA_SEARCH_PROVIDER=tavily
MIA_TOTAL_BUDGET_SECONDS=60
MIA_CONFIDENCE_THRESHOLD=0.55
MIA_MIN_DISTINCT_DOMAINS=5
